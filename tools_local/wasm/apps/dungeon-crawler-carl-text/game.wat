(module
  (import "env" "gd_width" (func $width (result i32)))
  (import "env" "gd_height" (func $height (result i32)))
  (import "env" "gd_line_height" (func $line_height (result i32)))
  (import "env" "gd_text" (func $text (param i32 i32 i32 i32)))
  (import "env" "gd_rect" (func $rect (param i32 i32 i32 i32 i32)))

  (memory (export "memory") 1)
  (data (i32.const 16) "DUNGEON CRAWLER CARL\00")
  (data (i32.const 64) "A text adventure\00")
  (data (i32.const 96) "THE SYSTEM IS OPEN\00")
  (data (i32.const 128) "Survive floors, syndicates, bosses, and fame.\00")
  (data (i32.const 192) "Confirm to enter\00")
  (data (i32.const 256) "ROOM: Training Hall\00")
  (data (i32.const 320) "ROOM: Crawling Market\00")
  (data (i32.const 384) "ROOM: Bomb Shelter\00")
  (data (i32.const 448) "ROOM: Syndicate Court\00")
  (data (i32.const 512) "ROOM: Creature Menagerie\00")
  (data (i32.const 576) "ROOM: Foundry\00")
  (data (i32.const 640) "ROOM: Boss Antechamber\00")
  (data (i32.const 704) "A brass crawler skitters from the darkness.\00")
  (data (i32.const 768) "A market goblin offers questionable upgrades.\00")
  (data (i32.const 832) "The walls are rigged with magical traps.\00")
  (data (i32.const 896) "Contestants chant beyond a floodgate.\00")
  (data (i32.const 960) "A royal cat studies you from a velvet throne.\00")
  (data (i32.const 1024) "FLOOR: \00")
  (data (i32.const 1088) "STATUS: STRONG\00")
  (data (i32.const 1120) "STATUS: WOUNDED\00")
  (data (i32.const 1152) "STATUS: CRITICAL\00")
  (data (i32.const 1184) "COMPANION: Princess Fluff\00")
  (data (i32.const 1248) "COMPANION: Donny the Bone\00")
  (data (i32.const 1312) "XP, gold, potions, bombs, keys, quests\00")
  (data (i32.const 1376) "Confirm: fight/enter  Up: inspect\00")
  (data (i32.const 1440) "Down: rest  Left: use bomb  Right: spend gold\00")
  (data (i32.const 1504) "COMBAT\00")
  (data (i32.const 1536) "Enemy: Iron-Crown Crawler\00")
  (data (i32.const 1600) "Enemy: Explosive Wraith\00")
  (data (i32.const 1664) "Enemy: Judge of Floors\00")
  (data (i32.const 1728) "Enemy: Royal Menagerie Beast\00")
  (data (i32.const 1792) "Confirm: attack  Down: potion  Left: bomb\00")
  (data (i32.const 1856) "Right: flee to safety\00")
  (data (i32.const 1920) "TRAP AVOIDED: looted a hidden key.\00")
  (data (i32.const 1984) "MARKET: bought a surgical upgrade.\00")
  (data (i32.const 2048) "QUEST: survived a Syndicate room.\00")
  (data (i32.const 2112) "REST: gained health and reputation.\00")
  (data (i32.const 2176) "VICTORY\00")
  (data (i32.const 2208) "You descended beneath the tenth floor.\00")
  (data (i32.const 2272) "Confirm to begin a new run\00")
  (data (i32.const 2336) "RUN OVER\00")
  (data (i32.const 2400) "The show must go on.\00")
  (data (i32.const 2464) "Confirm to retry\00")

  (global $mode (mut i32) (i32.const 0))
  (global $floor (mut i32) (i32.const 1))
  (global $room (mut i32) (i32.const 1))
  (global $hp (mut i32) (i32.const 100))
  (global $maxhp (mut i32) (i32.const 100))
  (global $enemyhp (mut i32) (i32.const 44))
  (global $enemymax (mut i32) (i32.const 44))
  (global $attack (mut i32) (i32.const 14))
  (global $gold (mut i32) (i32.const 18))
  (global $xp (mut i32) (i32.const 0))
  (global $potions (mut i32) (i32.const 3))
  (global $bombs (mut i32) (i32.const 2))
  (global $keys (mut i32) (i32.const 1))
  (global $quests (mut i32) (i32.const 0))
  (global $reputation (mut i32) (i32.const 0))
  (global $message (mut i32) (i32.const 1312))

  (func $resetEnemy
    (global.set $enemymax
      (i32.add (i32.mul (global.get $floor) (i32.const 12)) (i32.const 32)))
    (global.set $enemyhp (global.get $enemymax)))

  (func $newFloor
    (global.set $mode (i32.const 1))
    (global.set $floor (i32.add (global.get $floor) (i32.const 1)))
    (global.set $room (i32.const 1))
    (global.set $maxhp (i32.add (global.get $maxhp) (i32.const 8)))
    (global.set $hp (global.get $maxhp))
    (global.set $attack (i32.add (global.get $attack) (i32.const 2)))
    (global.set $potions (i32.add (global.get $potions) (i32.const 1)))
    (global.set $bombs (i32.add (global.get $bombs) (i32.const 1)))
    (global.set $keys (i32.add (global.get $keys) (i32.const 1)))
    (global.set $message (i32.const 2112))
    (call $resetEnemy))

  (func $damagePlayer
    (global.set $hp
      (i32.sub (global.get $hp)
        (i32.add (i32.mul (global.get $floor) (i32.const 3)) (i32.const 4))))
    (if (i32.le_s (global.get $hp) (i32.const 0))
      (then (global.set $hp (i32.const 0)) (global.set $mode (i32.const 3)))) )

  (func $attackEnemy
    (global.set $enemyhp (i32.sub (global.get $enemyhp) (global.get $attack)))
    (if (i32.gt_s (global.get $enemyhp) (i32.const 0))
      (then (call $damagePlayer))
      (else
        (global.set $enemyhp (i32.const 0))
        (global.set $gold (i32.add (global.get $gold) (i32.mul (global.get $floor) (i32.const 20))))
        (global.set $xp (i32.add (global.get $xp) (i32.mul (global.get $floor) (i32.const 30))))
        (global.set $reputation (i32.add (global.get $reputation) (i32.const 2)))
        (global.set $message (i32.const 2176))
        (global.set $room (i32.add (global.get $room) (i32.const 1)))
        (if (i32.gt_s (global.get $room) (i32.const 7))
          (then
            (if (i32.ge_s (global.get $floor) (i32.const 10))
              (then (global.set $mode (i32.const 4)))
              (else (call $newFloor)))
          ) (else (global.set $mode (i32.const 1)))))))

  (func $enemyName (param $result i32) (result i32)
    (local $n i32)
    (local.set $n (i32.rem_u (global.get $floor) (i32.const 4)))
    (if (i32.eq (local.get $n) (i32.const 0)) (then (return (i32.const 1728))))
    (if (i32.eq (local.get $n) (i32.const 1)) (then (return (i32.const 1536))))
    (if (i32.eq (local.get $n) (i32.const 2)) (then (return (i32.const 1600))))
    (i32.const 1664))

  (func $roomText (param $result i32) (result i32)
    (local $n i32)
    (local.set $n (i32.rem_u (global.get $room) (i32.const 6)))
    (if (i32.eq (local.get $n) (i32.const 0)) (then (return (i32.const 640))))
    (if (i32.eq (local.get $n) (i32.const 1)) (then (return (i32.const 256))))
    (if (i32.eq (local.get $n) (i32.const 2)) (then (return (i32.const 320))))
    (if (i32.eq (local.get $n) (i32.const 3)) (then (return (i32.const 384))))
    (if (i32.eq (local.get $n) (i32.const 4)) (then (return (i32.const 448))))
    (i32.const 512))

  (func $drawHP
    (if (i32.gt_s (global.get $hp) (i32.div_s (global.get $maxhp) (i32.const 2)))
      (then (call $text (i32.const 24) (i32.const 118) (i32.const 1088) (i32.const 0)))
      (else
        (if (i32.gt_s (global.get $hp) (i32.div_s (global.get $maxhp) (i32.const 4)))
          (then (call $text (i32.const 24) (i32.const 118) (i32.const 1120) (i32.const 0)))
          (else (call $text (i32.const 24) (i32.const 118) (i32.const 1152) (i32.const 0)))))))

  (func $drawTitle (export "gd_render")
    (if (i32.eq (global.get $mode) (i32.const 0))
      (then
        (call $rect (i32.const 12) (i32.const 12) (call $width) (i32.const 72) (i32.const 1))
        (call $text (i32.const 24) (i32.const 26) (i32.const 16) (i32.const 1))
        (call $text (i32.const 24) (i32.const 58) (i32.const 64) (i32.const 1))
        (call $text (i32.const 24) (i32.const 112) (i32.const 96) (i32.const 1))
        (call $text (i32.const 24) (i32.const 148) (i32.const 128) (i32.const 0))
        (call $rect (i32.const 24) (i32.const 190) (i32.sub (call $width) (i32.const 48)) (i32.const 78) (i32.const 0))
        (call $text (i32.const 40) (i32.const 206) (i32.const 192) (i32.const 0))) )
    (if (i32.eq (global.get $mode) (i32.const 3))
      (then
        (call $rect (i32.const 12) (i32.const 12) (call $width) (i32.const 72) (i32.const 1))
        (call $text (i32.const 24) (i32.const 26) (i32.const 2336) (i32.const 1))
        (call $text (i32.const 24) (i32.const 112) (i32.const 2400) (i32.const 1))
        (call $text (i32.const 24) (i32.const 148) (i32.const 2464) (i32.const 0))) )
    (if (i32.eq (global.get $mode) (i32.const 4))
      (then
        (call $rect (i32.const 12) (i32.const 12) (call $width) (i32.const 72) (i32.const 1))
        (call $text (i32.const 24) (i32.const 26) (i32.const 2176) (i32.const 1))
        (call $text (i32.const 24) (i32.const 112) (i32.const 2208) (i32.const 1))
        (call $text (i32.const 24) (i32.const 148) (i32.const 2272) (i32.const 0))) )
    (if (i32.eq (global.get $mode) (i32.const 1))
      (then
        (call $rect (i32.const 12) (i32.const 12) (call $width) (i32.const 72) (i32.const 1))
        (call $text (i32.const 24) (i32.const 26) (i32.const 1024) (i32.const 1))
        (call $text (i32.const 24) (i32.const 58) (i32.const 1184) (i32.const 1))
        (call $drawHP)
        (call $rect (i32.const 24) (i32.const 150) (i32.sub (call $width) (i32.const 48)) (i32.const 84) (i32.const 0))
        (call $text (i32.const 40) (i32.const 166) (call $roomText (i32.const 0)) (i32.const 1))
        (call $text (i32.const 40) (i32.const 198) (i32.const 1312) (i32.const 0))
        (call $rect (i32.const 24) (i32.const 252) (i32.sub (call $width) (i32.const 48)) (i32.const 92) (i32.const 0))
        (call $text (i32.const 40) (i32.const 268) (i32.const 1376) (i32.const 0))
        (call $text (i32.const 40) (i32.const 294) (i32.const 1440) (i32.const 0)) ))
    (if (i32.eq (global.get $mode) (i32.const 2))
      (then
        (call $rect (i32.const 12) (i32.const 12) (call $width) (i32.const 72) (i32.const 1))
        (call $text (i32.const 24) (i32.const 26) (i32.const 1504) (i32.const 1))
        (call $text (i32.const 24) (i32.const 58) (call $enemyName (i32.const 0)) (i32.const 1))
        (call $drawHP)
        (call $rect (i32.const 24) (i32.const 150) (i32.sub (call $width) (i32.const 48)) (i32.const 100) (i32.const 0))
        (call $text (i32.const 40) (i32.const 168) (i32.const 704) (i32.const 0))
        (call $rect (i32.const 24) (i32.const 270) (i32.sub (call $width) (i32.const 48)) (i32.const 82) (i32.const 0))
        (call $text (i32.const 40) (i32.const 286) (i32.const 1792) (i32.const 0))
        (call $text (i32.const 40) (i32.const 312) (i32.const 1856) (i32.const 0)) )) )

  (func (export "gd_input") (param $code i32) (param $x i32) (param $y i32) (result i32)
    (if (i32.eq (global.get $mode) (i32.const 0))
      (then (if (i32.eq (local.get $code) (i32.const 5)) (then (global.set $mode (i32.const 1)) (call $resetEnemy))) (return (i32.const 1))))
    (if (i32.eq (global.get $mode) (i32.const 3))
      (then (if (i32.eq (local.get $code) (i32.const 5))
        (then
          (global.set $mode (i32.const 0)) (global.set $floor (i32.const 1)) (global.set $room (i32.const 1))
          (global.set $hp (i32.const 100)) (global.set $maxhp (i32.const 100)) (global.set $gold (i32.const 18))
          (global.set $xp (i32.const 0)) (global.set $attack (i32.const 14)) (global.set $potions (i32.const 3))
          (global.set $bombs (i32.const 2)) (global.set $keys (i32.const 1)) (global.set $quests (i32.const 0))
          (global.set $reputation (i32.const 0)) (call $resetEnemy))) (return (i32.const 1))))
    (if (i32.eq (global.get $mode) (i32.const 4))
      (then (if (i32.eq (local.get $code) (i32.const 5))
        (then (global.set $mode (i32.const 0)))) (return (i32.const 1))))

    (if (i32.eq (global.get $mode) (i32.const 2))
      (then
        (if (i32.eq (local.get $code) (i32.const 5)) (then (call $attackEnemy)))
        (if (i32.eq (local.get $code) (i32.const 2))
          (then
            (if (i32.gt_s (global.get $potions) (i32.const 0))
              (then
                (global.set $potions (i32.sub (global.get $potions) (i32.const 1)))
                (global.set $hp (i32.add (global.get $hp) (i32.const 36)))
                (if (i32.gt_s (global.get $hp) (global.get $maxhp)) (then (global.set $hp (global.get $maxhp))))))))
        (if (i32.eq (local.get $code) (i32.const 3))
          (then
            (if (i32.gt_s (global.get $bombs) (i32.const 0))
              (then
                (global.set $bombs (i32.sub (global.get $bombs) (i32.const 1)))
                (global.set $enemyhp (i32.sub (global.get $enemyhp) (i32.const 30)))
                (if (i32.le_s (global.get $enemyhp) (i32.const 0)) (then (call $attackEnemy)))))))
        (if (i32.eq (local.get $code) (i32.const 4))
          (then (global.set $mode (i32.const 1)) (global.set $hp (i32.add (global.get $hp) (i32.const 4)))
            (if (i32.gt_s (global.get $hp) (global.get $maxhp)) (then (global.set $hp (global.get $maxhp))))))
        (return (i32.const 1))) )

    (if (i32.eq (local.get $code) (i32.const 5))
      (then (global.set $mode (i32.const 2)) (call $resetEnemy)))
    (if (i32.eq (local.get $code) (i32.const 1))
      (then (global.set $message (i32.const 1920)) (global.set $keys (i32.add (global.get $keys) (i32.const 1)))))
    (if (i32.eq (local.get $code) (i32.const 2))
      (then
        (if (i32.gt_s (global.get $maxhp) (global.get $hp))
          (then (global.set $hp (i32.add (global.get $hp) (i32.const 18)))
            (if (i32.gt_s (global.get $hp) (global.get $maxhp)) (then (global.set $hp (global.get $maxhp))))))
        (global.set $message (i32.const 2112))))
    (if (i32.eq (local.get $code) (i32.const 3))
      (then
        (if (i32.gt_s (global.get $bombs) (i32.const 0))
          (then (global.set $bombs (i32.sub (global.get $bombs) (i32.const 1)))
            (global.set $message (i32.const 1920)) (global.set $keys (i32.add (global.get $keys) (i32.const 1)))))))
    (if (i32.eq (local.get $code) (i32.const 4))
      (then
        (if (i32.ge_s (global.get $gold) (i32.const 12))
          (then
            (global.set $gold (i32.sub (global.get $gold) (i32.const 12)))
            (global.set $attack (i32.add (global.get $attack) (i32.const 3)))
            (global.set $reputation (i32.add (global.get $reputation) (i32.const 1)))
            (global.set $message (i32.const 1984))))))
    (return (i32.const 1)))
)
